default_platform(:ios)

APP_ID = "com.mickeyoh.naru"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

def connect_api!
  require 'spaceship'
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
  )
end

platform :ios do
  desc "Latest build processing state (PROCESSING → VALID means live in TestFlight)"
  lane :status do
    connect_api!
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    build = app.get_builds(sort: "-uploadedDate").first
    if build.nil?
      UI.important("STATUS: no builds yet")
    else
      UI.important("STATUS: build #{build.version} #{build.processing_state}")
    end
  end

  desc "One-time: register bundle ID and create the app in App Store Connect"
  lane :bootstrap do
    connect_api!

    if Spaceship::ConnectAPI::BundleId.find(APP_ID)
      UI.message("Bundle ID #{APP_ID} already registered")
    else
      # Raw API call: spaceship 2.237.0's BundleId.create sends a 'capability'
      # relationship Apple no longer accepts (fastlane/fastlane#29596)
      require 'net/http'
      require 'json'
      uri = URI("https://api.appstoreconnect.apple.com/v1/bundleIds")
      req = Net::HTTP::Post.new(uri)
      req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      req["Content-Type"] = "application/json"
      req.body = { data: { type: "bundleIds", attributes: {
        name: "Naru", identifier: APP_ID, platform: "IOS" } } }.to_json
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
      UI.user_error!("Bundle ID registration failed: #{res.code} #{res.body}") unless res.code.to_i == 201
      UI.success("Registered bundle ID #{APP_ID}")
    end

    if Spaceship::ConnectAPI::App.find(APP_ID)
      UI.message("App record already exists in App Store Connect")
    else
      Spaceship::ConnectAPI::App.create(
        name: "Naru",
        version_string: "0.1.0",
        sku: "naru-ios",
        primary_locale: "en-US",
        bundle_id: APP_ID,
        platforms: [Spaceship::ConnectAPI::Platform::IOS]
      )
      UI.success("Created app record 'Naru' in App Store Connect")
    end
  end

  desc "One-time per machine: distribution certificate + App Store profile"
  lane :signing do
    api_key = asc_key
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: APP_ID)
  end

  desc "Build, sign, and upload to TestFlight"
  lane :ship do
    api_key = asc_key
    profile = sigh(api_key: api_key, app_identifier: APP_ID, readonly: true)

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1

    sh("cd .. && xcodegen generate")

    build_app(
      project: "Naru.xcodeproj",
      scheme: "Naru",
      export_method: "app-store",
      output_directory: "build",
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{lane_context[SharedValues::SIGH_NAME]}'"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success("Build #{build_number} uploaded — it appears in TestFlight after Apple finishes processing (~5-15 min)")
  end
end
