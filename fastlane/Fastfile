default_platform(:ios)

APP_ID = "com.mickeyoh.naru"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

platform :ios do
  desc "One-time: register bundle ID and create the app in App Store Connect"
  lane :bootstrap do
    produce(
      api_key: asc_key,
      app_identifier: APP_ID,
      app_name: "Naru",
      language: "en-US",
      app_version: "0.1.0",
      sku: "naru-ios"
    )
  end

  desc "One-time per machine: distribution certificate + App Store profile"
  lane :signing do
    api_key = asc_key
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: APP_ID)
  end

  desc "Build, sign, and upload to TestFlight"
  lane :ship do
    api_key = asc_key
    profile = sigh(api_key: api_key, app_identifier: APP_ID, readonly: true)

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1

    sh("cd .. && xcodegen generate")

    build_app(
      project: "Naru.xcodeproj",
      scheme: "Naru",
      export_method: "app-store",
      output_directory: "build",
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{lane_context[SharedValues::SIGH_NAME]}'"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success("Build #{build_number} uploaded — it appears in TestFlight after Apple finishes processing (~5-15 min)")
  end
end
