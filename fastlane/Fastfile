default_platform(:ios)

APP_ID = "com.mickeyoh.naru"
SHARE_ID = "com.mickeyoh.naru.share"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

def connect_api!
  require 'spaceship'
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
  )
end

def asc_request(req_class, path, body = nil)
  require 'net/http'
  require 'json'
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  req = req_class.new(uri)
  req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  req["Content-Type"] = "application/json"
  req.body = body.to_json if body
  Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
end

def asc_post(path, body)
  asc_request(Net::HTTP::Post, path, body)
end

def asc_get(path)
  asc_request(Net::HTTP::Get, path)
end

def asc_patch(path, body)
  asc_request(Net::HTTP::Patch, path, body)
end

platform :ios do
  desc "Latest build processing state (PROCESSING → VALID means live in TestFlight)"
  lane :status do
    connect_api!
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    build = app.get_builds(sort: "-uploadedDate").first
    if build.nil?
      UI.important("STATUS: no builds yet")
    else
      res = asc_get("/v1/builds/#{build.id}/buildBetaDetail")
      beta = JSON.parse(res.body).dig("data", "attributes") || {}
      UI.important("STATUS: build #{build.version} #{build.processing_state} " \
                   "internal=#{beta['internalBuildState']} external=#{beta['externalBuildState']}")
    end
  end

  desc "One-time: internal-tester group with access to all builds + add tester"
  lane :invite do |options|
    connect_api!
    require 'net/http'
    require 'json'
    email = options[:email] || UI.user_error!("Pass email:...")
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    group = app.get_beta_groups.find { |g| g.is_internal_group }
    if group.nil?
      uri = URI("https://api.appstoreconnect.apple.com/v1/betaGroups")
      req = Net::HTTP::Post.new(uri)
      req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      req["Content-Type"] = "application/json"
      req.body = { data: { type: "betaGroups",
        attributes: { name: "Team", isInternalGroup: true, hasAccessToAllBuilds: true },
        relationships: { app: { data: { type: "apps", id: app.id } } } } }.to_json
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
      UI.user_error!("Group creation failed: #{res.code} #{res.body}") unless res.code.to_i == 201
      group_id = JSON.parse(res.body).dig("data", "id")
      UI.success("Created internal group 'Team'")
    else
      group_id = group.id
      UI.message("Using existing internal group '#{group.name}'")
    end

    uri = URI("https://api.appstoreconnect.apple.com/v1/betaTesters")
    req = Net::HTTP::Post.new(uri)
    req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
    req["Content-Type"] = "application/json"
    req.body = { data: { type: "betaTesters",
      attributes: { email: email },
      relationships: { betaGroups: { data: [{ type: "betaGroups", id: group_id }] } } } }.to_json
    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
    UI.user_error!("Tester add failed: #{res.code} #{res.body}") unless res.code.to_i == 201
    UI.success("Added #{email} to internal testing — check the TestFlight app")
  end

  desc "Invite an external tester and distribute the latest build (first build needs Beta App Review)"
  lane :external do |options|
    email = options[:email] || UI.user_error!("Pass email:...")
    connect_api!
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    group = app.get_beta_groups.find { |g| g.name == "Friends" }
    if group.nil?
      res = asc_post("/v1/betaGroups", { data: { type: "betaGroups",
        attributes: { name: "Friends" },
        relationships: { app: { data: { type: "apps", id: app.id } } } } })
      UI.user_error!("Group creation failed: #{res.code} #{res.body}") unless res.code.to_i == 201
      group_id = JSON.parse(res.body).dig("data", "id")
      UI.success("Created external group 'Friends'")
    else
      group_id = group.id
    end

    res = asc_post("/v1/betaTesters", { data: { type: "betaTesters",
      attributes: { email: email },
      relationships: { betaGroups: { data: [{ type: "betaGroups", id: group_id }] } } } })
    if res.code.to_i == 201
      UI.success("Invited #{email} to 'Friends'")
    elsif res.code.to_i == 409
      UI.message("#{email} already invited")
    else
      UI.user_error!("Tester add failed: #{res.code} #{res.body}")
    end

    # pilot's distribute_only crashes in non-interactive mode (fastlane#20974),
    # so drive the API directly: what-to-test, group link, beta review submission
    res = asc_get("/v1/builds?filter[app]=#{app.id}&sort=-uploadedDate&limit=1")
    build = JSON.parse(res.body)["data"].first || UI.user_error!("No builds found")
    build_id = build["id"]
    UI.message("Latest build: #{build.dig('attributes', 'version')} (#{build_id})")

    res = asc_post("/v1/betaBuildLocalizations", { data: { type: "betaBuildLocalizations",
      attributes: { locale: "en-US",
        whatsNew: "First Naru build — paste links into your inbox; they persist across launches." },
      relationships: { build: { data: { type: "builds", id: build_id } } } } })
    UI.message("What-to-test: #{res.code}")

    res = asc_post("/v1/betaGroups/#{group_id}/relationships/builds",
      { data: [{ type: "builds", id: build_id }] })
    UI.user_error!("Build-to-group link failed: #{res.code} #{res.body}") unless res.code.to_i == 204
    UI.success("Build added to 'Friends'")

    beta_desc = "Naru is a personal content inbox — paste links you want to keep " \
                "and they arrive in one place. Early build validating the release pipeline."
    res = asc_get("/v1/apps/#{app.id}/betaAppLocalizations")
    loc = JSON.parse(res.body)["data"].find { |l| l.dig("attributes", "locale") == "en-US" }
    if loc.nil?
      res = asc_post("/v1/betaAppLocalizations", { data: { type: "betaAppLocalizations",
        attributes: { locale: "en-US", description: beta_desc, feedbackEmail: "hello@mickeyoh.com" },
        relationships: { app: { data: { type: "apps", id: app.id } } } } })
      UI.message("Beta app description created: #{res.code}")
    elsif loc.dig("attributes", "description").to_s.empty?
      res = asc_patch("/v1/betaAppLocalizations/#{loc['id']}", { data: {
        type: "betaAppLocalizations", id: loc["id"],
        attributes: { description: beta_desc, feedbackEmail: "hello@mickeyoh.com" } } })
      UI.message("Beta app description updated: #{res.code}")
    end

    res = asc_get("/v1/apps/#{app.id}/betaAppReviewDetail")
    detail = JSON.parse(res.body)["data"]
    if detail && detail.dig("attributes", "contactEmail").to_s.empty?
      attrs = { contactEmail: "hello@mickeyoh.com", contactFirstName: "Mickey", contactLastName: "Oh" }
      attrs[:contactPhone] = options[:phone] if options[:phone]
      res = asc_patch("/v1/betaAppReviewDetails/#{detail['id']}", { data: {
        type: "betaAppReviewDetails", id: detail["id"], attributes: attrs } })
      UI.message("Beta review contact info: #{res.code}")
    end

    res = asc_post("/v1/betaAppReviewSubmissions", { data: { type: "betaAppReviewSubmissions",
      relationships: { build: { data: { type: "builds", id: build_id } } } } })
    if res.code.to_i == 201
      UI.success("Submitted for Beta App Review — external testers get it once approved")
    else
      UI.important("Beta review submission: #{res.code} #{res.body}")
    end
  end

  desc "Debug: dump beta app localizations"
  lane :debug_loc do
    connect_api!
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    res = asc_get("/v1/apps/#{app.id}/betaAppLocalizations")
    UI.important("RESPONSE #{res.code}: #{res.body}")
  end

  desc "One-time: register bundle ID and create the app in App Store Connect"
  lane :bootstrap do
    connect_api!

    if Spaceship::ConnectAPI::BundleId.find(APP_ID)
      UI.message("Bundle ID #{APP_ID} already registered")
    else
      # Raw API call: spaceship 2.237.0's BundleId.create sends a 'capability'
      # relationship Apple no longer accepts (fastlane/fastlane#29596)
      require 'net/http'
      require 'json'
      uri = URI("https://api.appstoreconnect.apple.com/v1/bundleIds")
      req = Net::HTTP::Post.new(uri)
      req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      req["Content-Type"] = "application/json"
      req.body = { data: { type: "bundleIds", attributes: {
        name: "Naru", identifier: APP_ID, platform: "IOS" } } }.to_json
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
      UI.user_error!("Bundle ID registration failed: #{res.code} #{res.body}") unless res.code.to_i == 201
      UI.success("Registered bundle ID #{APP_ID}")
    end

    if Spaceship::ConnectAPI::App.find(APP_ID)
      UI.message("App record already exists in App Store Connect")
    else
      Spaceship::ConnectAPI::App.create(
        name: "Naru",
        version_string: "0.1.0",
        sku: "naru-ios",
        primary_locale: "en-US",
        bundle_id: APP_ID,
        platforms: [Spaceship::ConnectAPI::Platform::IOS]
      )
      UI.success("Created app record 'Naru' in App Store Connect")
    end
  end

  desc "One-time per machine: distribution certificate + App Store profiles"
  lane :signing do
    api_key = asc_key
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: APP_ID)
    sigh(api_key: api_key, app_identifier: SHARE_ID)
  end

  desc "Build, sign, and upload to TestFlight"
  lane :ship do
    api_key = asc_key
    # non-readonly: recreates profiles invalidated by capability changes
    sigh(api_key: api_key, app_identifier: APP_ID)
    app_profile = lane_context[SharedValues::SIGH_NAME]
    sigh(api_key: api_key, app_identifier: SHARE_ID)
    share_profile = lane_context[SharedValues::SIGH_NAME]

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1

    sh("cd .. && xcodegen generate")

    # per-target profiles — a global PROVISIONING_PROFILE_SPECIFIER xcarg
    # would stamp the app profile onto the extension
    [[%w[Naru], APP_ID, app_profile],
     [%w[NaruShare], SHARE_ID, share_profile]].each do |targets, bundle_id, profile|
      update_code_signing_settings(
        path: "Naru.xcodeproj",
        targets: targets,
        use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
        bundle_identifier: bundle_id
      )
    end

    build_app(
      project: "Naru.xcodeproj",
      scheme: "Naru",
      export_method: "app-store",
      output_directory: "build",
      export_options: {
        provisioningProfiles: { APP_ID => app_profile, SHARE_ID => share_profile }
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success("Build #{build_number} uploaded — it appears in TestFlight after Apple finishes processing (~5-15 min)")
  end
end

platform :ios do
  desc "One-time: register share-extension bundle ID (app group itself is web-UI-only)"
  lane :bootstrap_share do
    connect_api!

    if Spaceship::ConnectAPI::BundleId.find(SHARE_ID)
      UI.message("Bundle ID #{SHARE_ID} already registered")
    else
      res = asc_post("/v1/bundleIds", { data: { type: "bundleIds", attributes: {
        name: "Naru Share", identifier: SHARE_ID, platform: "IOS" } } })
      UI.user_error!("Bundle ID registration failed: #{res.code} #{res.body}") unless res.code.to_i == 201
      UI.success("Registered bundle ID #{SHARE_ID}")
    end

    # /v1/appGroups is 404 — app group creation + assignment to bundle IDs
    # must be done at developer.apple.com > Identifiers (web UI only)
    UI.important("Manual step: create group.com.mickeyoh.naru under Identifiers > App Groups, " \
                 "then enable App Groups (with that group) on #{APP_ID} and #{SHARE_ID}")
  end
end
